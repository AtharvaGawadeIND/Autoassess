# Copy this file to .env.local and adjust for your setup.

# Base path/URL the frontend calls for all API requests.
# Leave as /api during local dev (vite.config.js proxies it to FastAPI on :8000).
# In production, point it straight at the deployed FastAPI host, e.g.
# VITE_API_BASE_URL=https://api.autoassess.example.com
VITE_API_BASE_URL=/api

# true  -> frontend runs entirely on in-browser mock data (no backend needed)
# false -> frontend calls the real FastAPI backend
VITE_MOCK_MODE=true
